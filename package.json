{
  "name": "@fingerly/lynx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "Lynx SDK backed by Fingerly's native iOS and Android SDKs",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["android", "generated", "ios", "src", "types", "lynx.lib.json", "README.md"],
  "scripts": {
    "codegen": "lynx-autolink-codegen",
    "build": "pnpm codegen && tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "example:build": "pnpm --dir example build"
  },
  "dependencies": {
    "@fingerly/types": "workspace:*"
  },
  "devDependencies": {
    "@lynx-js/autolink-codegen": "0.6.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
